# Google Analytics 4 measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# =============================================================================
# Rutherford Academy — Supabase auth + Stripe payments
# Copy this file to `.env.local` for local dev, and set the same values in
# Vercel Project Settings → Environment Variables for production.
# =============================================================================

# Feature flag — set to "true" locally to expose /academy/* and /account/*.
# Leave undefined (or "false") in production until the LMS is ready to launch.
NEXT_PUBLIC_ACADEMY_ENABLED=true

# Supabase (project: cawumjturiizzhzjtuiy)
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://cawumjturiizzhzjtuiy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (dashboard.stripe.com)
# Use test keys (pk_test_…/sk_test_…) until ready to take real payments.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs — create one Stripe Product per masterclass + one for the
# Academy Pass, then paste the `price_…` IDs here.
STRIPE_PRICE_CLOSED_LOOP=
STRIPE_PRICE_MEASURECOLOR_PRODUCTION=
STRIPE_PRICE_MEASURECOLOR_REPORTS=
STRIPE_PRICE_INTELLITRAX2=
STRIPE_PRICE_COLORLOOP_AI=
STRIPE_PRICE_OFFSET360=
STRIPE_PRICE_ACADEMY_PASS=

# =============================================================================
# Console validation (/console-validation) — lead routing
# Every integration below is dormant-safe: leave it blank and that step is
# skipped. With none set, photos still go to Supabase Storage (above).
# See docs/console-validation.md for how to obtain each value.
# =============================================================================

# Customer portal (/account/console-validations) — set "true" to expose it.
NEXT_PUBLIC_CONSOLE_TRACKING_ENABLED=

# Dropbox — store the photos + infos.txt in a folder named after the deal.
# Preferred: a refresh token (access tokens expire after ~4h).
DROPBOX_REFRESH_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Alternative to the three above for a quick test (expires after ~4h):
DROPBOX_ACCESS_TOKEN=
# Base folder (default "/Dossier RUTHERFORD/Prospects information"):
DROPBOX_FOLDER=
# Team space (Dropbox Business): namespace id + team_member_id, if needed.
DROPBOX_PATH_ROOT=
DROPBOX_SELECT_USER=
# Sales folder created for each won deal (3rd step of the Zap being replaced).
# Blank = that step is skipped, so the Asana half can be switched over first.
# Production value: /Serveur RIG/documents/EMILIE/Ventes
DROPBOX_ORDERS_FOLDER=

# Asana — create one task per request in the "Console Validation V2" board.
# ASANA_ACCESS_TOKEN is a Personal Access Token (Asana → Settings → Apps).
# Project / section / assignee default to the live board + FX; override to retarget.
ASANA_ACCESS_TOKEN=
ASANA_CONSOLE_VALIDATION_PROJECT=
ASANA_CONSOLE_VALIDATION_SECTION=
ASANA_FX_GID=
ASANA_FOLLOWER_GID=
# Secret echoed during webhook creation (set after the handshake) for /api/asana-webhook.
ASANA_WEBHOOK_SECRET=

# Asana "Install" board — one task per won Pipedrive deal (/api/pipedrive-webhook).
# ASANA_INSTALL_PROJECT has NO default on purpose: leave it blank and nothing is
# created, so the Zap can keep running until you're ready to switch over.
# Live gids: project 731409919229383 · section "To control" 1201798768968949
#            collaborator Emilie 774875611076804 · "ID" custom field 1212566134774832
ASANA_INSTALL_PROJECT=
ASANA_INSTALL_SECTION=
ASANA_INSTALL_FOLLOWER_GID=
ASANA_INSTALL_DEAL_FIELD=
# Workspace searched to detect a task the Zap already created. Default: VEORIA - Rutherford.
ASANA_WORKSPACE_GID=

# Discord — ping a channel on each new console validation / support ticket, and
# the monthly storage watchdog. Create it in Discord: Channel settings →
# Integrations → Webhooks → New Webhook → copy URL. Leave blank to disable (no-op).
DISCORD_WEBHOOK_URL=

# Storage watchdog — a monthly Vercel Cron (see vercel.json) checks the
# console-validations photo bucket and pings Discord above if it exceeds this
# many GB. Default 20. Manual cleanup lives at /api/admin/storage?cleanup=1.
STORAGE_ALERT_GB=
# Optional: if set, the cron endpoint requires `Authorization: Bearer $CRON_SECRET`
# (Vercel Cron sends it automatically). Leave blank to allow the cron unauthenticated.
CRON_SECRET=

# Super-admins : les SEULS comptes autorisés à nommer un administrateur (basculer
# is_admin), et uniquement sur des comptes de l'équipe Rutherford. Liste d'e-mails
# séparés par des virgules. Défaut : fx@rutherford.fr. À ajuster à votre e-mail.
SUPER_ADMIN_EMAILS=

# Pipedrive — create the Deal (API v2) + attach Notes. Stage/pipeline/owner are
# optional ids; set them so deals land in the right place.
PIPEDRIVE_API_TOKEN=
# Optional: your Pipedrive subdomain, e.g. "veoria" → veoria.pipedrive.com
PIPEDRIVE_DOMAIN=
PIPEDRIVE_PIPELINE_ID=
PIPEDRIVE_STAGE_ID=
PIPEDRIVE_OWNER_ID=
# Basic-auth pair protecting /api/pipedrive-webhook (deal WON → Asana Install).
# Use the same username/password when creating the webhook in Pipedrive. Both
# blank = the route ignores every event.
PIPEDRIVE_WEBHOOK_USER=
PIPEDRIVE_WEBHOOK_PASSWORD=
# Optional: pin a description label to a Pipedrive custom-field key when the
# field is named differently from what we look for, e.g.
# {"PO":"a1b2…","Press interface":"c3d4…"}. Normally unnecessary — fields are
# matched by name.
PIPEDRIVE_DEAL_FIELDS=

# Microsoft Graph — client-facing emails (acknowledgement + approve/reject).
MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MAIL_FROM=

# PostHog product analytics (EU). Without the key the site sends nothing —
# create a dedicated Rutherford.fr project (the VEORIA org's existing project
# belongs to another site) and paste its "Project API key" here.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
